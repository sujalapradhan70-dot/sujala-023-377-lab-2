class BlocksWorld:
    def __init__(self, current_state, goal_state):
        self.current_state = current_state
        self.goal_state = goal_state
        self.blocks = list(current_state.keys())

    def get_support_structure(self, block, state):
        support_structure = [block]
        current = block
        # Traverse downward until Table
        while state[current] != 'Table':
            current = state[current]
            support_structure.append(current)
        return support_structure

    def has_correct_support(self, block, current_state, goal_state):
        return current_state[block] == goal_state[block]

    def calculate_heuristic(self):
        heuristic_values = {block: 0 for block in self.blocks}
        print("CALCULATING HEURISTIC VALUE")
        print(f"Current State: {self.current_state}")
        print(f"Goal State:    {self.goal_state}")

        for block in self.blocks:
            support_structure = self.get_support_structure( block, self.current_state)
            if self.has_correct_support( block, self.current_state, self.goal_state ):
                print(f"\nBlock '{block}' has CORRECT support")
                print(f"  On: {self.current_state[block]}")
                print(f"  Support structure: {support_structure}")
                print("  Adding +1 to:")
                for support_block in support_structure:
                    heuristic_values[support_block] += 1
                    print(f"    {support_block}  +1")
            else:
                print(f"\nBlock '{block}' has WRONG support")
                print(f"  Current: {self.current_state[block]}")
                print(f"  Goal:    {self.goal_state[block]}")
                print(f"  Support structure: {support_structure}")
                print("  Adding -1 to:")
                for support_block in support_structure:
                    heuristic_values[support_block] -= 1
                    print(f"    {support_block}  -1")

        total_heuristic = sum(heuristic_values.values())
        print("HEURISTIC CALCULATION SUMMARY")
        for block, value in sorted(heuristic_values.items()):
            print(f"Block {block}: {value}")
        print(f"Total Heuristic Value e(p): {total_heuristic}")
        return heuristic_values, total_heuristic

    def get_blocks_above(self, block, state):
        tower = [block]
        while True:
            found = False
            for b in self.blocks:
                if state[b] == tower[-1] and b not in tower:
                    tower.append(b)
                    found = True
                    break
            if not found:
                break
        return tower

    def visualize_state(self, state, title="State"):
        print(f"\n{title}:")
        towers = {}
        for block in self.blocks:
            if state[block] == 'Table':
                towers[block] = self.get_blocks_above(block, state)
        if not towers:
            print("  No towers found.")
            return
        for base, tower in towers.items():
            print("  " + " <- ".join(reversed(tower)))

def example1():
    print("\n# EXAMPLE 1: Simple 3-Block Tower")
    current_state = {
        'A': 'Table',
        'B': 'A',
        'C': 'B'
    }
    goal_state = {
        'A': 'Table',
        'B': 'A',
        'C': 'B'
    }
    bw = BlocksWorld(current_state, goal_state)
    bw.visualize_state(current_state, "Current State")
    bw.visualize_state(goal_state, "Goal State")
    bw.calculate_heuristic()

